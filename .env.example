# ====================================================================
# Sevgilim Cepte — Client Environment Variables
# ====================================================================
# Copy this file as ".env" and fill in your values.
# The .env file is in .gitignore and is never committed.
#
# IMPORTANT: API secrets (OpenAI, ElevenLabs, D-ID) are NOT client-side
# environment variables. They are set as Supabase Edge Function secrets:
#
#   supabase secrets set OPENAI_API_KEY=sk-...
#
# See docs/SECURITY_ARCHITECTURE.md for details.
# ====================================================================

# Supabase (required)
# Found in Supabase Dashboard > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Expo EAS projectId (recommended for push notifications)
# Run `eas init` to generate, then paste the UUID here.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Public sign-up toggle (set to "true" to allow new registrations)
# For private production deployment, keep this "false" after
# the intended users are created.
EXPO_PUBLIC_ALLOW_SIGNUP=false
