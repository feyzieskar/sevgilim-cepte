# ====================================================================
# Sevgilim Cepte - Ortam Değişkenleri (örnek dosya)
# ====================================================================
# Bu dosyayı ".env" olarak kopyalayın ve gerçek anahtarlarınızı girin.
# .env dosyası .gitignore içindedir, asla commit edilmez.
#
# NOT: OPENAI_API_KEY, app.config.js içinde "extra.openaiApiKey" olarak
#      uygulamaya geçirilir ve ilk açılışta expo-secure-store'a yazılıp
#      oradan okunur. Bu dosyayı ".env" olarak kopyalamayı unutma.
# ====================================================================

# OpenAI (Feyzi AI sohbet - GPT-4o)  ** ZORUNLU **
OPENAI_API_KEY=

# ElevenLabs (Sesli mod - text to speech)
EXPO_PUBLIC_ELEVENLABS_API_KEY=

# D-ID (Konuşan video)
EXPO_PUBLIC_DID_API_KEY=

# Supabase (opsiyonel - 2. faz backend)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
